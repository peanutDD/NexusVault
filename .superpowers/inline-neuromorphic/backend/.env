DATABASE_URL=postgresql://file_storage:file_storage_password@localhost:5432/file_storage
JWT_SECRET=local_dev_jwt_secret_that_is_long_enough_for_hs256
STORAGE_BACKEND=local
STORAGE_PATH=./uploads
PORT=3000
CORS_ORIGIN=*
ORPHAN_CLEANUP_INTERVAL_SECS=86400
# 24 小时孤儿存储清理总开关；false = 暂时禁用轮询清理（功能保留，随时改 true 恢复）
ORPHAN_CLEANUP_ENABLED=false
FILES_CONSISTENCY_CHECK_BATCH_SIZE=10000
